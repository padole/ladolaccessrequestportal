# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string

# MySQL example (the original app used this database):
# DATABASE_URL=mysql+mysqlconnector://root@127.0.0.1/accessportalv3
# Leave unset to use a local SQLite file in ./instance

# Mail (Gmail needs an App Password). Leave MAIL_SERVER empty to disable sending.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=Ladol Access
MAIL_SENDER_EMAIL=

# Public URL of the site, used for links in emails (e.g. https://access.ladol.com)
FRONTEND_URL=http://localhost:5180

# Sign in with Microsoft 365. Values come from the Entra ID app registration
# (see docs/MICROSOFT_SIGN_IN.md). Leave empty to hide the Microsoft button.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Only these email domains may sign in with Microsoft (comma-separated)
MS_ALLOWED_DOMAINS=ladol.com

# Set to true when served over HTTPS
SESSION_COOKIE_SECURE=false
